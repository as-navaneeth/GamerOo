<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Page Not Found</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    
    <style>
        /* Background Gradient */
        body {
            font-family: 'Arial', sans-serif;
            background: linear-gradient(135deg, #f4f4f4, #ddd);
            color: #333;
            text-align: center;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }

        /* Error Icon */
        i {
            font-size: 100px;
            color: #e74c3c;
            animation: shake 0.8s ease infinite alternate;
        }

        @keyframes shake {
            0% { transform: translateX(-5px); }
            100% { transform: translateX(5px); }
        }

        /* Headings */
        h1 {
            font-size: 3em;
            color: #e74c3c;
            margin: 10px 0;
        }

        h2 {
            font-size: 2em;
            color: #555;
            margin-bottom: 10px;
        }

        p {
            font-size: 1.2em;
            color: #777;
            max-width: 500px;
            margin: 10px auto;
        }

        /* Button Styling */
        button {
            background: #007bff;
            color: #fff;
            border: none;
            padding: 12px 25px;
            border-radius: 30px;
            cursor: pointer;
            font-size: 1.1em;
            transition: all 0.3s ease-in-out;
            margin-top: 15px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
        }

        button:hover {
            background: #0056b3;
            transform: scale(1.05);
            box-shadow: 0 6px 14px rgba(0, 0, 0, 0.3);
        }

        button:focus {
            outline: none;
        }

        /* Responsive Design */
        @media (max-width: 600px) {
            h1 {
                font-size: 2.5em;
            }

            h2 {
                font-size: 1.8em;
            }

            p {
                font-size: 1.1em;
            }

            button {
                font-size: 1em;
                padding: 10px 20px;
            }
        }
    </style>
</head>
<body>
    <i class="fa fa-exclamation-triangle"></i>
    <h1>Oops!</h1>
    <h2>Page Not Found</h2>
    <p><%= message || "The page you are looking for might have been removed, had its name changed, or is temporarily unavailable." %></p>
    <button onclick="goToHomePage()">Go to Home Page</button>

    <script>
        function goToHomePage() {
            window.location.href = "/";
        }
    </script>
</body>
</html>
    